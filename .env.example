# Copy to .env.local and fill in. NEVER commit .env.local.
# No NEXT_PUBLIC_ prefix on any key below, or it ships to the browser in the JS bundle.

# --- Classification: Jev via OpenRouter -------------------------------------
# Typed decisions go to {SYSTEMONE_BASE_URL}/systemone  -- NOT chat completions.
OPENROUTER_API_KEY=
SYSTEMONE_BASE_URL=https://openrouter.ai/api/v1
# Pin the version. Never use the TypeSafe console id "jev-1.13.0" here.
SYSTEMONE_MODEL=jev-1.13
# Raise carefully. OpenRouter rate limits are unpublished. P50 latency is ~0.26s.
SYSTEMONE_CONCURRENCY=20

# --- Fallback: self-hosted Laya (same /v1/systemone wire shape) -------------
# To swap, point SYSTEMONE_BASE_URL at a laya-serve instance and change the model.
# LAYA_BASE_URL=http://localhost:8000/v1
# LAYA_MODEL=english

# --- Summaries (narrate, plainLanguage): Hackathon organizers' Gemini proxy ----
# Text generation goes through the organizers' proxy. No @google/genai SDK: plain fetch.
# Base URL is optional; defaults to the hackathon organizers' proxy if not set.
GEMINI_PROXY_BASE_URL=
GEMINI_API_KEY=
# Model must be one the proxy supports. Confirmed working: gemini-3-flash-preview
GEMINI_MODEL=gemini-3-flash-preview

# --- Vision and OCR: Images via OpenRouter (proxy cannot parse parts arrays) ----
# The proxy cannot handle multipart image messages. Images go to OpenRouter using the
# existing OPENROUTER_API_KEY below. OpenRouter is confirmed to accept image input
# and structured outputs. Using google/gemini-3.5-flash-lite here.
VISION_MODEL=google/gemini-3.5-flash-lite

# --- QUOTA WARNING ---
# The hackathon has 1,000 requests TOTAL for the entire event (~996 remaining).
# FAILED REQUESTS COUNT AGAINST QUOTA. Circuit breaker: after any 401/403/429,
# all proxy calls return null to avoid burning the remaining quota on repeated failures.
# The proxy stores and logs prompts and responses, so send nothing sensitive.

# --- Spend control ---------------------------------------------------------
# Real dollars per browser session, metered from the provider usage.cost field.
SESSION_BUDGET_USD=2.00
# Judges enter this for unlimited processing. Publish it in the writeup.
JUDGE_ACCESS_CODE=
# Hard daily ceiling across all sessions.
DAILY_CEILING_USD=20.00
# Set to 1 to stop all paid calls and serve heuristic labels only.
KILL_SWITCH=0
# Shown in the over-budget panel.
CONTACT_EMAIL=

# --- Dev -------------------------------------------------------------------
# 1 makes the client read fixtures/ instead of the network. Also the stage fallback.
NEXT_PUBLIC_USE_FIXTURES=0
